---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Cerita film fiksi — tonton cuplikannya, baca cerita lengkapnya.' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href)) ? 'active' : '';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="msvalidate.01" content="07495D2F46FB8E07B2C0637A18D26379" />
    <meta name="google-site-verification" content="D59jmIl0KQTypTnzNz8Ahuc_mxmQ56IIrGl_pmRzu1k" />
    <title>{title} | Anime Story Films</title>
    <style is:global>
      :root { color-scheme: dark; --bg: #141414; --card: #1e1e1e; --text: #f5f1e8; --muted: #b8b2a4; --pink: #c9a96a; --pink-dark: #a68a4e; --pink-bright: #e3c98f; --yellow: #f7c948; --line: #33302a; --green: #7cb342; --green-dark: #9ccc65; --purple: #9c5aa8; --orange: #ff6b35; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; background: var(--bg); color: var(--text); line-height: 1.65; }
      a { color: var(--pink-bright); }
      /* ---- Header: Editorial Sinema, charcoal + gold, sticky ---- */
      header.site-header { background: #141414; color: var(--text); border-bottom: 2px solid var(--pink); position: sticky; top: 0; z-index: 50; }
      .header-top { max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; justify-content: space-between; padding: 16px 20px; }
      header.site-header .brand { text-decoration: none; font-family: Georgia, 'Times New Roman', serif; font-weight: 700; color: var(--text); font-size: 1.6rem; line-height: 1; white-space: nowrap; }
      header.site-header .brand span { color: var(--pink); font-style: italic; }
      header.site-header .header-search { flex: 1 1 240px; max-width: 380px; display: flex; }
      header.site-header .header-search input { flex: 1; padding: 9px 12px; border: 1px solid #444; border-right: none; border-radius: 4px 0 0 4px; font-size: .95rem; background: #1e1e1e; color: var(--text); min-width: 0; }
      header.site-header .header-search button { padding: 9px 14px; border: 1px solid var(--pink); border-radius: 0 4px 4px 0; background: var(--pink); color: #141414; font-weight: 700; cursor: pointer; font-size: .95rem; }
      header.site-header .top-nav { display: flex; flex-wrap: wrap; gap: 4px 22px; align-items: center; }
      header.site-header .top-nav a { color: var(--pink); text-decoration: none; font-weight: 700; font-size: .8rem; text-transform: uppercase; letter-spacing: .14em; }
      header.site-header .top-nav a:hover { color: var(--pink-bright); }
      header.site-header .top-nav a.active { color: var(--pink-bright); text-decoration: underline; text-underline-offset: 4px; }
      /* ---- Film bar: charcoal strip with the four films ---- */
      .film-bar { background: #1c1c1c; border-bottom: 1px solid var(--line); }
      .film-bar-inner { max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 4px 28px; padding: 10px 20px; }
      .film-bar a { color: var(--muted); text-decoration: none; font-weight: 700; font-size: .85rem; text-transform: uppercase; letter-spacing: .06em; }
      .film-bar a:hover { color: var(--pink-bright); }
      .film-bar a.active { color: var(--pink-bright); text-decoration: underline; text-underline-offset: 4px; }
      main { max-width: 1100px; margin: 0 auto; padding: 32px 20px 64px; }
      h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 2.4rem; line-height: 1.15; margin: .2em 0 .4em; font-weight: 700; }
      h2 { font-family: Georgia, 'Times New Roman', serif; margin-top: 2em; border-bottom: 1px solid var(--line); padding-bottom: .3em; font-weight: 700; }
      h3 { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; }
      .lede { font-family: Georgia, 'Times New Roman', serif; font-size: 1.2rem; color: var(--muted); max-width: 720px; }
      /* ---- Hero unggulan beranda (Editorial) ---- */
      .hero-featured { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--pink); border-radius: 4px; padding: 24px; margin: 16px 0 32px; }
      .hero-featured img { width: 420px; max-width: 100%; height: auto; border-radius: 4px; display: block; aspect-ratio: 16 / 9; object-fit: cover; }
      .hero-featured .hero-kicker { color: var(--pink); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; margin: 0 0 8px; }
      .hero-featured h2 { font-family: Georgia, 'Times New Roman', serif; font-size: 2rem; line-height: 1.15; margin: 0 0 8px; border: none; padding: 0; }
      .hero-featured p { color: var(--muted); margin: 6px 0; }
      .hero-featured .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
      .tag { display: inline-block; background: var(--pink); color: #141414; padding: 2px 10px; border-radius: 999px; font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 4px; padding: 0 0 20px; margin: 16px 0; overflow: hidden; }
      .card h3 { margin: 16px 20px 0; }
      .card p { margin: 8px 20px 0; }
      .card .meta { color: var(--pink-bright); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin: 16px 20px 0; }
      .card .byline { color: var(--muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; margin: 8px 20px 0; }
      .card img { width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; object-fit: cover; }
      .btn { display: inline-block; background: var(--pink); color: #141414; padding: 10px 18px; border-radius: 4px; text-decoration: none; font-weight: 700; text-transform: uppercase; font-size: .9rem; }
      .btn:hover { background: var(--pink-dark); }
      .btn.disabled { opacity: .45; pointer-events: none; }
      .btn.secondary { background: transparent; border: 2px solid var(--pink); color: var(--pink-bright); }
      .btn-pink-wide { display: block; max-width: 480px; margin: 24px auto; text-align: center; background: var(--pink); color: #141414; padding: 14px 20px; border-radius: 4px; text-decoration: none; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
      .btn-pink-wide:hover { background: var(--pink-dark); }
      video { width: 100%; border-radius: 4px; background: #000; }
      .scene { margin: 24px 0; }
      .scene p { color: var(--muted); margin: .5em 0 0; font-size: .95rem; }
      .note { background: #1a1a1a; border-left: 4px solid var(--pink); padding: 12px 16px; font-size: .95rem; }
      .grid { display: grid; gap: 24px; grid-template-columns: repeat(2, 1fr); }
      .filter { display: flex; flex-wrap: wrap; gap: 8px 20px; border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 8px; }
      .filter a { color: var(--muted); text-decoration: none; font-size: .85rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
      .filter a.active { color: var(--pink-bright); border-bottom: 2px solid var(--pink); padding-bottom: 10px; }
      .placeholder { height: 200px; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 900; font-size: 1.4rem; text-transform: uppercase; text-align: center; padding: 20px; }
      .hero img { width: 100%; height: auto; border-radius: 4px; display: block; }
      .map-wrap iframe { width: 100%; max-width: 600px; height: 450px; border: 0; display: block; }
      .mailing-form { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
      .mailing-form input[type="email"] { flex: 1 1 200px; padding: 10px 12px; border: 1px solid #555; border-radius: 4px; background: #111; color: #fff; font-size: .95rem; }
      .mailing-form button { padding: 10px 18px; border: none; border-radius: 4px; background: var(--pink); color: #141414; font-weight: 700; text-transform: uppercase; cursor: pointer; }
      /* ---- Poster grid (LK21 catalogue) ---- */
      .poster-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
      .poster-card { background: var(--card); border: 1px solid var(--line); border-radius: 4px; overflow: hidden; }
      .poster-media { position: relative; display: block; }
      .poster-media img { width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; object-fit: cover; }
      .poster-badge { position: absolute; top: 8px; left: 8px; background: var(--pink); color: #141414; font-size: .75rem; font-weight: 800; padding: 2px 8px; border-radius: 3px; text-transform: uppercase; }
      .poster-badge-hd { position: absolute; top: 8px; right: 8px; background: transparent; border: 1px solid var(--pink); color: var(--pink-bright); font-size: .75rem; font-weight: 800; padding: 2px 8px; border-radius: 3px; }
      .poster-body { padding: 12px 14px 16px; }
      .poster-body h3 { margin: 0; font-size: 1.05rem; }
      .poster-body h3 a { color: #fff; text-decoration: none; }
      .poster-body h3 a:hover { color: var(--pink-bright); }
      .poster-body .poster-meta { color: var(--muted); font-size: .85rem; margin: 6px 0 0; }
      .poster-body .poster-desc { color: #ddd; font-size: .9rem; margin: 8px 0 0; }
      .continue-watching { background: var(--card); border: 1px solid var(--line); border-radius: 4px; padding: 20px; margin: 16px 0 24px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
      .continue-watching img { width: 280px; max-width: 100%; height: auto; border-radius: 4px; display: block; aspect-ratio: 16 / 9; object-fit: cover; }
      .continue-watching h3 { margin: 0 0 6px; }
      .continue-watching h3 a { color: #fff; text-decoration: none; }
      .continue-watching p { color: var(--muted); margin: 4px 0; }
      /* ---- Footer: Editorial, charcoal ---- */
      footer.site-footer { background: #101010; color: var(--text); padding: 48px 24px 24px; border-top: 2px solid var(--pink); }
      .footer-inner { max-width: 1200px; margin: 0 auto; }
      .footer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
      footer.site-footer .footer-logo { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; line-height: .95; font-size: 1.8rem; text-decoration: none; display: block; margin-bottom: 16px; color: var(--text); }
      footer.site-footer .footer-logo span { color: var(--pink); font-style: italic; }
      footer.site-footer h4 { color: var(--text); font-size: .95rem; text-transform: uppercase; letter-spacing: .05em; margin: 0 0 12px; border-bottom: 2px solid var(--pink); padding-bottom: 8px; display: inline-block; }
      footer.site-footer p { color: #ddd; font-size: .95rem; margin: 6px 0; }
      footer.site-footer ul { list-style: none; margin: 0; padding: 0; }
      footer.site-footer ul li { margin: 6px 0; }
      footer.site-footer ul li::before { content: "• "; color: var(--pink-bright); }
      footer.site-footer a { color: #fff; text-decoration: none; }
      footer.site-footer a:hover { text-decoration: underline; }
      footer.site-footer .social-links { display: flex; gap: 18px; align-items: center; }
      footer.site-footer .social-links a { color: var(--pink-bright); display: inline-flex; align-items: center; }
      footer.site-footer .social-links a:hover { color: #fff; }
      footer.site-footer .social-links svg { width: 20px; height: 20px; display: block; }
      .footer-bottom { max-width: 1200px; margin: 32px auto 0; border-top: 1px solid #333; padding-top: 20px; color: #bbb; font-size: .9rem; text-align: center; }
      .footer-bottom a { color: #fff; }
      /* ---- Cookie consent banner ---- */
      .cookie-banner { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 100; max-width: 720px; margin: 0 auto; background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--pink); border-radius: 4px; padding: 16px 20px; box-shadow: 0 8px 24px rgba(0,0,0,.5); display: none; }
      .cookie-banner.show { display: block; }
      .cookie-banner p { color: #ddd; font-size: .95rem; margin: 0 0 12px; }
      .cookie-banner p a { color: var(--pink-bright); }
      .cookie-actions { display: flex; flex-wrap: wrap; gap: 10px; }
      .cookie-actions button { padding: 9px 18px; border: none; border-radius: 4px; font-weight: 700; text-transform: uppercase; cursor: pointer; font-size: .85rem; }
      .cookie-accept { background: var(--pink); color: #141414; }
      .cookie-accept:hover { background: var(--pink-dark); }
      .cookie-decline { background: transparent; border: 2px solid var(--pink); color: var(--pink-bright); }
      @media (max-width: 820px) {
        .footer-grid { grid-template-columns: repeat(2, 1fr); }
        header.site-header .header-search { order: 3; flex-basis: 100%; max-width: none; }
      }
      @media (max-width: 640px) {
        .grid { grid-template-columns: 1fr; }
        .footer-grid { grid-template-columns: 1fr; }
        h1 { font-size: 1.8rem; }
        header.site-header .brand { font-size: 1.2rem; }
        .continue-watching img { width: 100%; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-top">
        <a class="brand" href="/">Anime <span>Story Films</span></a>
        <form class="header-search" action="/episodes/" method="get" role="search">
          <input type="search" name="q" placeholder="Cari judul film di Anime Story Films" aria-label="Cari film" />
          <button type="submit" aria-label="Cari">Cari</button>
        </form>
        <nav class="top-nav" aria-label="Navigasi utama">
          <a href="/" class={isActive('/')}>Beranda</a>
          <a href="/episodes/" class={isActive('/episodes/')}>Semua Film</a>
          <a href="/about/" class={isActive('/about/')}>Tentang</a>
          <a href="/contact/" class={isActive('/contact/')}>Kontak</a>
        </nav>
      </div>
    </header>
    <nav class="film-bar" aria-label="Film">
      <div class="film-bar-inner">
        <a href="/films/ember-blade/" class={isActive('/films/ember-blade/')}>Ember Blade</a>
        <a href="/films/shadow-of-the-ronin/" class={isActive('/films/shadow-of-the-ronin/')}>Shadow of the Ronin</a>
        <a href="/films/the-soldier-who-came-home/" class={isActive('/films/the-soldier-who-came-home/')}>The Soldier Who Came Home</a>
        <a href="/films/bintang-yang-jatuh-ke-seoul/" class={isActive('/films/bintang-yang-jatuh-ke-seoul/')}>Bintang yang Jatuh ke Seoul</a>
        <a href="/episodes/" class={isActive('/episodes/')}>Semua Episode →</a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-grid">
          <div>
            <a class="footer-logo" href="/">Anime <span>Story Films</span></a>
            <p>Blog cerita film fiksi original — tonton cuplikannya, baca cerita lengkapnya, episode demi episode.</p>
            <p>Jalan Citra Graha Blok F 9, Deli Serdang 20371, Sumatera Utara, Indonesia<br /><a href="mailto:animestory2009@gmail.com">animestory2009@gmail.com</a><br /><a href="tel:+6282276113289">+6282276113289</a></p>
