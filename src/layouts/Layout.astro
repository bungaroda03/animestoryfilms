---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Fiction film stories — watch the clip, read the real story.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Anime Story Films</title>
    <style>
      :root { color-scheme: light dark; --bg: #14100c; --card: #211a14; --text: #f5ead9; --muted: #c9b8a3; --accent: #e8542f; --accent2: #f2b134; --line: #3a2f24; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: Georgia, 'Times New Roman', serif; background: var(--bg); color: var(--text); line-height: 1.65; }
      a { color: var(--accent2); }
      header { border-bottom: 1px solid var(--line); padding: 16px 20px; display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: baseline; }
      header .brand { font-size: 1.4rem; font-weight: bold; letter-spacing: .04em; color: var(--text); text-decoration: none; }
      header .brand span { color: var(--accent); }
      nav a { color: var(--muted); text-decoration: none; margin-right: 16px; }
      nav a:hover { color: var(--text); }
      main { max-width: 860px; margin: 0 auto; padding: 28px 20px 64px; }
      h1 { font-size: 2.2rem; line-height: 1.15; margin: .2em 0 .4em; }
      h2 { margin-top: 2em; border-bottom: 1px solid var(--line); padding-bottom: .3em; }
      .tag { display: inline-block; background: var(--accent); color: #fff; padding: 2px 10px; border-radius: 999px; font-size: .8rem; font-family: system-ui, sans-serif; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 20px; margin: 16px 0; }
      .card h3 { margin-top: 0; }
      .btn { display: inline-block; background: var(--accent); color: #fff; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-family: system-ui, sans-serif; font-weight: 600; }
      .btn.disabled { opacity: .45; pointer-events: none; }
      .btn.secondary { background: transparent; border: 1px solid var(--accent2); color: var(--accent2); }
      video { width: 100%; border-radius: 10px; background: #000; }
      .scene { margin: 20px 0; }
      .scene p { color: var(--muted); margin: .5em 0 0; font-family: system-ui, sans-serif; font-size: .95rem; }
      .note { background: #2a2118; border-left: 4px solid var(--accent2); padding: 12px 16px; font-family: system-ui, sans-serif; font-size: .95rem; }
      footer { border-top: 1px solid var(--line); padding: 20px; text-align: center; color: var(--muted); font-family: system-ui, sans-serif; font-size: .9rem; }
      .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/">Anime <span>Story</span> Films</a>
      <nav>
        <a href="/">Home</a>
        <a href="/films/ember-blade/">Ember Blade</a>
        <a href="/films/ember-blade/episode-1/">Episode 1</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Anime Story Films — original fiction film stories. Watch the clip, read the real story.
    </footer>
  </body>
</html>
