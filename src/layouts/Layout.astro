    <div class="cookie-banner" id="cookie-banner" role="dialog" aria-label="Persetujuan cookie">
      <p>Kami menggunakan cookie agar situs ini berfungsi, dan — jika iklan ditampilkan — Google AdSense dapat memakai cookie untuk menayangkan iklan yang relevan. Baca <a href="/cookies/">Kebijakan Cookie</a> kami.</p>
      <div class="cookie-actions">
        <button type="button" class="cookie-accept" id="cookie-accept">Terima Semua</button>
        <button type="button" class="cookie-decline" id="cookie-decline">Tolak</button>
      </div>
    </div>
    <script>
      (function () {
        var key = 'asf-cookie-consent';
        var banner = document.getElementById('cookie-banner');
        try {
          if (!localStorage.getItem(key)) banner.classList.add('show');
        } catch (e) { banner.classList.add('show'); }
        function choose(v) {
          try { localStorage.setItem(key, v); } catch (e) {}
          banner.classList.remove('show');
        }
        document.getElementById('cookie-accept').addEventListener('click', function () { choose('accepted'); });
        document.getElementById('cookie-decline').addEventListener('click', function () { choose('declined'); });
      })();
    </script>
  </body>
</html>
