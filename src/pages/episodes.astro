    <div class="poster-card" data-genre="aksi anime">
      <a class="poster-media" href="/films/shadow-of-the-ronin/episode-3/">
        <img src="/images/media-generation-shadow-ronin-ep3-thumbnail-0-7560dcc4-52c1-4f9f-8231-25aee4d32a73.webp" alt="Shadow of the Ronin Episode 3 — Bayangan Terakhir" />
        <span class="poster-badge">EPS 30</span>
        <span class="poster-badge-hd">HD</span>
