---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Episodes" description="All Ember Blade episodes — Episode 1 and Episode 2 are out now.">
  <h1>Episodes</h1>
  <p>
    Every episode of <strong>Ember Blade</strong> — watch the clip, read
    the full story, and continue to the next cliffhanger.
  </p>

  <div class="poster-grid">
    <div class="poster-card">
      <a class="poster-media" href="/films/ember-blade/episode-1/">
        <img src="/images/ember-blade-thumbnail.webp" alt="Ember Blade Episode 1 — The Village That Burned Twice" />
        <span class="poster-badge">EPS 12</span>
        <span class="poster-badge-hd">HD</span>
      </a>
      <div class="poster-body">
        <h3><a href="/films/ember-blade/episode-1/">Episode 1 — The Village That Burned Twice</a></h3>
        <p class="poster-meta">2026 · Action, Anime · 5 min</p>
        <p class="poster-desc">Ryu returns to a village that has burned twice — and the man who burned it is waiting. Scenes 1–12 of 30, with the full story in writing below the clips.</p>
        <p><a href="/films/ember-blade/episode-1/">Watch &amp; Read Episode 1</a></p>
      </div>
    </div>
    <div class="poster-card">
      <a class="poster-media" href="/films/ember-blade/episode-2/">
        <img src="/images/media-generation-ember-blade-ep2-thumbnail-clic-0-b850f488-75bd-4d1f-9357-81efe0ee403c.webp" alt="Ember Blade Episode 2 — The Fire Remembers" />
        <span class="poster-badge">EPS 6</span>
        <span class="poster-badge-hd">HD</span>
      </a>
      <div class="poster-body">
        <h3><a href="/films/ember-blade/episode-2/">Episode 2 — The Fire Remembers</a></h3>
        <p class="poster-meta">2026 · Action, Anime · 5 min</p>
        <p class="poster-desc">The fire wakes for the first time in three years. Ryu frees Aiko — but the fire is burning his own hand, and Kaito has what he came for. Scenes 1–6 of 30, with the story in writing below the clips.</p>
        <p><a href="/films/ember-blade/episode-2/">Watch &amp; Read Episode 2</a></p>
      </div>
    </div>
  </div>
</Layout>
